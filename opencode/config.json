{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".github/copilot-instructions.md"],
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "environment": {
        "BRAVE_API_KEY": "$BRAVE_BROWSER_SEARCH_API_KEY"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "$HOME/Applications/Chromium.app/Contents/MacOS/Chromium"
      ],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_LICENSE_KEY}"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["docker", "run", "--interactive", "--rm", "mcp/fetch"],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--interactive",
        "--rm",
        "--env",
        "{env:GITHUB_TOKEN}",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": false
    }
  },
  "model": "lmstudio/gemma-4-26b-a4b-qat",
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B A4B"
        },
        "gemma-4-12b-qat": {
          "name": "Gemma 4 12B"
        },
        "gemma-4-e4b": {
          "name": "Gemma 4 E4B"
        },
        "gemma-4-e4b-it-qat": {
          "name": "Gemma 4 E4B IT"
        },
        "qwen3.5-9b-deepseek-v4-flash": {
          "name": "Qwen3.5 9B Flash"
        }
      }
    },
    "turbofieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TurboFieldfare",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B-A4B IT"
        }
      }
    }
  }
}
